# Default: private loopback server, no password needed.
LANDOWNLOAD_HOST=127.0.0.1
LANDOWNLOAD_PORT=8000
# Access key. Required to use the server from other devices (tunnel, GitHub Pages UI).
# Use a long random value; `start.ps1 -Remote` generates one for you.
# LANDOWNLOAD_TOKEN=
# Optional absolute path to a Netscape-format cookie file. Never commit it.
# LANDOWNLOAD_COOKIES=C:/private/cookies.txt
# Optional FFmpeg binary directory, if it is not on PATH.
# LANDOWNLOAD_FFMPEG=C:/ffmpeg/bin
# Files and history are stored here, relative to the project root.
LANDOWNLOAD_DATA=data
LANDOWNLOAD_WORKERS=2
LANDOWNLOAD_RETENTION_HOURS=48
# Websites allowed to call this server, e.g. your GitHub Pages copy of the UI (comma separated).
# LANDOWNLOAD_ORIGINS=https://your-user.github.io
